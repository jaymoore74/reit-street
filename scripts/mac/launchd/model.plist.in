<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Generated template: install_launchd.sh fills @ROOT@. Edit times here, then rerun install_launchd.sh. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.reitstreet.model</string>
  <key>ProgramArguments</key>
  <array><string>/bin/bash</string><string>@ROOT@/scripts/mac/serve_model.sh</string></array>
  <key>WorkingDirectory</key><string>@ROOT@</string>
  <key>EnvironmentVariables</key>
  <dict><key>REITSTREET_PROFILE</key><string>local</string></dict>
  <key>StandardOutPath</key><string>@ROOT@/data/logs/launchd-model.log</string>
  <key>StandardErrorPath</key><string>@ROOT@/data/logs/launchd-model.log</string>
  <key>ProcessType</key><string>Standard</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
</dict>
</plist>
