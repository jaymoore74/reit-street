{
  "name": "@reitstreet/web",
  "version": "0.1.0",
  "private": true,
  "description": "REIT Street client website: research, charts, data downloads, newsletter sign-up",
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/copy-static.mjs",
    "start": "node .next/standalone/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node tests/e2e/smoke.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "3.1166.0",
    "exceljs": "4.4.0",
    "hyparquet-writer": "0.18.0",
    "mysql2": "3.24.6",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "recharts": "3.10.1",
    "remark-gfm": "4.0.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.6",
    "hyparquet": "1.33.0",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
